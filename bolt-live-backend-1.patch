+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { confirmedFill, floorQuantity, stepDecimals, dailyLossState, LIVE_ENTRIES_ENABLED } from '../supabase/functions/_shared/trading-safety.ts';
+
+test('release cannot enable new live entries through a DB/browser toggle', () => assert.equal(LIVE_ENTRIES_ENABLED, false));
+test('lot precision supports scientific notation and fractional steps', () => {
+  assert.equal(stepDecimals(1e-7), 7);
+  assert.equal(floorQuantity(0.00000019, 1e-7), 0.0000001);
+  assert.equal(floorQuantity(1.239, 0.01), 1.23);
+  assert.equal(floorQuantity(1.29, 0.05), 1.25);
+  assert.throws(() => floorQuantity(NaN, 0.01));
+  assert.throws(() => floorQuantity(1, 0));
+});
+const filled = { orderId: 123, status: 'FILLED', executedQty: '2', cummulativeQuoteQty: '180',
+  fills: [{ price: '90', qty: '2', commission: '0.18', commissionAsset: 'USDT' }] };
+test('only actual fills and fees determine proceeds; no target-price profit', () => {
+  assert.deepEqual(confirmedFill(filled, 'TEST', 'SELL'), { orderId: '123', quantity: 2, price: 90, quote: 179.82 });
+});
+test('failed, partial, missing and unvalued fills cannot close positions', () => {
+  for (const order of [{}, { ...filled, status: 'REJECTED' }, { ...filled, status: 'PARTIALLY_FILLED' },
+    { ...filled, fills: [] }, { ...filled, executedQty: '3' },
+    { ...filled, fills: [{ price: '90', qty: '2', commission: '0.01', commissionAsset: 'BNB' }] }]) {
+    assert.throws(() => confirmedFill(order, 'TEST', 'SELL'));
+  }
+});
+test('base-asset fees affect the actual inventory sold', () => {
+  const result = confirmedFill({ ...filled, fills: [{ price: '90', qty: '2', commission: '0.01', commissionAsset: 'TEST' }] }, 'TEST', 'SELL');
+  assert.equal(result.quantity, 2.01);
+});
+test('daily loss resets to persisted new epoch; same-day resets preserve losses', () => {
+  const now = Date.parse('2026-10-04T12:00:00Z');
+  assert.deepEqual(dailyLossState(12, '2026-10-03T11:00:00Z', now), { loss: 0, resetAt: new Date(now).toISOString() });
+  assert.equal(dailyLossState(12, '2026-10-04T11:00:00Z', now).loss, 12);
+});
