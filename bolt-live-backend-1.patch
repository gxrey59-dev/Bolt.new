+import { createClient } from 'npm:@supabase/supabase-js@2.57.4';
+import { authorize } from '../_shared/auth.ts';
+import { PROTOCOLS, makeRpc, readProtocol, type Protocol, type ProtocolSnapshot } from '../_shared/protocols.ts';
+import { verifySignedTransaction, validatePolicy, receiptTransfers, type ExecutionPolicy } from '../_shared/defi-execution.ts';
+import { verifyCompoundAccrual } from '../_shared/yield-accounting.ts';
+
+const db = createClient(Deno.env.get('SUPABASE_URL')!,Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!);
+const headers = { 'Access-Control-Allow-Origin':'*','Access-Control-Allow-Headers':'authorization,apikey,content-type,x-scheduler-token','Access-Control-Allow-Methods':'GET,POST,OPTIONS','Content-Type':'application/json' };
+const json = (body:unknown,status=200) => new Response(JSON.stringify(body),{status,headers});
+function must<T>(result:{data:T;error:unknown}):T { if(result.error) throw new Error('Database operation failed'); return result.data; }
+const updateJob = async (id:string,values:Record<string,unknown>) => must(await db.from('defi_jobs').update({...values,updated_at:new Date().toISOString()}).eq('id',id));
+async function leaseValid(token:string) { if(!must(await db.rpc('check_execution_lease',{p_token:token}))) throw new Error('Worker lease expired'); }
+
+async function executeOne(token:string, paused:boolean) {
+  const jobs = must(await db.from('defi_jobs').select('*').in('state',['signing','signed','broadcast','approved']).order('created_at').limit(100)) ?? [];
+  // Recovery takes priority. Never skip an unresolved transaction to sign a new one.
+  const job = jobs.find(j => j.state !== 'approved') ?? (!paused ? jobs[0] : undefined);
+  if(!job) return;
+  const config = PROTOCOLS[job.protocol as Protocol];
+  if(!config || job.chain !== config.chain) throw new Error('Job chain mismatch');
+  const rpc = makeRpc(Deno.env.get(`DEFI_RPC_${config.chain}`) ?? config.rpc,AbortSignal.timeout(20000));
+  if(Number(BigInt(String(await rpc('eth_chainId',[])))) !== config.chain) throw new Error('RPC chain mismatch');
+  if(!job.signed_raw) {
+    if(paused || Deno.env.get('DEFI_EXECUTION_ENABLED') !== 'true') return;
+    const policy = job.policy as ExecutionPolicy;
+    validatePolicy(policy);
+    if(policy.chain !== job.chain || policy.wallet.toLowerCase() !== job.wallet) throw new Error('Policy/job mismatch');
+    // This is a signing-only service: it must implement durable idempotency by job ID,
+    // enforce its own spending policy, return bytes and NEVER broadcast itself.
+    const signerUrl = Deno.env.get('DEFI_SIGNER_URL'), signerToken = Deno.env.get('DEFI_SIGNER_TOKEN');
+    if(!signerUrl || new URL(signerUrl).protocol !== 'https:' || !signerToken) throw new Error('Provision a signing-only service before funded execution');
+    const latest = Number(BigInt(String(await rpc('eth_getTransactionCount',[job.wallet,'latest']))));
+    const pending = Number(BigInt(String(await rpc('eth_getTransactionCount',[job.wallet,'pending']))));
+    if(latest !== pending || (job.nonce !== null && job.nonce !== latest)) throw new Error('Pending or externally replaced nonce; reconcile first');
+    const snapshot = await readProtocol(job.protocol,job.wallet,rpc);
+    if(Date.now()-snapshot.timestamp>180000) throw new Error('Stale state');
+    const estimate = BigInt(String(await rpc('eth_estimateGas',[{from:job.wallet,to:policy.to,data:policy.data,value:'0x'+BigInt(policy.value).toString(16)}])));
+    if(estimate>BigInt(policy.maxGas)) throw new Error('Estimated gas exceeds approved budget');
+    await leaseValid(token);
+    await updateJob(job.id,{state:'signing',nonce:latest});
+    const signedResponse = await fetch(signerUrl,{method:'POST',headers:{Authorization:`Bearer ${signerToken}`,'Content-Type':'application/json','Idempotency-Key':job.id},body:JSON.stringify({id:job.id,policy,nonce:latest}),signal:AbortSignal.timeout(15000)});
+    if(!signedResponse.ok) throw new Error(`Signer unavailable (${signedResponse.status})`);
+    const signed = await signedResponse.json();
+    const verified = verifySignedTransaction(signed.rawTransaction,policy);
+    if(verified.nonce !== latest) throw new Error('Signer returned wrong nonce');
+    await leaseValid(token);
+    await updateJob(job.id,{state:'signed',signed_raw:verified.raw,tx_hash:verified.hash});
+    job.nonce=latest; job.signed_raw=verified.raw; job.tx_hash=verified.hash; job.state='signed';
+  }
+  // Verify stored bytes too. Expiry blocks first broadcast, not receipt recovery.
+  const verified = verifySignedTransaction(job.signed_raw,job.policy,0);
+  if(verified.nonce !== Number(job.nonce)) throw new Error('Journal nonce mismatch');
+  if(verified.hash !== job.tx_hash) throw new Error('Journal hash mismatch');
+  const receipt = await rpc('eth_getTransactionReceipt',[job.tx_hash]) as {transactionHash:string;status:string;blockNumber:string;blockHash:string;logs:{address:string;topics:string[];data:string;logIndex:string}[]} | null;
+  if(receipt) {
+    const finalized = await rpc('eth_getBlockByNumber',['finalized',false]) as {number:string} | null;
+    if(!finalized || BigInt(finalized.number)<BigInt(receipt.blockNumber)) return;
+    const canonical = await rpc('eth_getBlockByNumber',[receipt.blockNumber,false]) as {hash:string}|null;
+    if(canonical?.hash !== receipt.blockHash) { await updateJob(job.id,{state:'orphaned',error:'Receipt was reorganized; operator reconciliation required'}); return; }
+    if(receipt.transactionHash.toLowerCase() !== job.tx_hash.toLowerCase()) throw new Error('Receipt hash mismatch');
+    await leaseValid(token);
+    must(await db.rpc('settle_defi_job',{p_id:job.id,p_receipt:receipt,p_flows:receipt.status==='0x1'?receiptTransfers(receipt,job.wallet):[]}));
+    return;
+  }
+  // Pausing blocks all new broadcasts, but keeps receipt reconciliation alive.
+  if(paused || Deno.env.get('DEFI_EXECUTION_ENABLED') !== 'true' || Date.now() >= job.policy.expiresAt) return;
+  const observed = await rpc('eth_getTransactionByHash',[job.tx_hash]);
+  if(observed) return;
+  await leaseValid(token);
+  const currentStatus = must(await db.from('defi_worker_status').select('paused').eq('id',1).single());
+  if (currentStatus?.paused !== false) return;
+  // Persist broadcast intent BEFORE network I/O. Retry sends identical bytes/hash only.
+  await updateJob(job.id,{state:'broadcast'});
+  const hash = await rpc('eth_sendRawTransaction',[job.signed_raw]);
+  if(String(hash).toLowerCase() !== job.tx_hash.toLowerCase()) throw new Error('RPC broadcast hash mismatch');
+}
+
+Deno.serve(async req => {
+  if(req.method==='OPTIONS') return new Response(null,{headers});
+  const path=new URL(req.url).pathname.replace('/defi-monitor','');
+  const denied=await authorize(req,db,headers,path==='/tick'&&req.method==='POST'); if(denied) return denied;
+  let lease:string|null=null;
+  try {
+    if(path==='/status'&&req.method==='GET') {
+      const status=must(await db.from('defi_worker_status').select('*').eq('id',1).single());
+      return json({ ...status, signerConfigured:Boolean(Deno.env.get('DEFI_SIGNER_URL')&&Deno.env.get('DEFI_SIGNER_TOKEN')), executionEnabled:Deno.env.get('DEFI_EXECUTION_ENABLED')==='true' });
+    }
+    if(path==='/pause'&&req.method==='POST') { must(await db.from('defi_worker_status').update({paused:true}).eq('id',1)); return json({paused:true}); }
+    if(path!=='/tick'||req.method!=='POST') return json({error:'Use GET /status, POST /tick or POST /pause'},405);
+    lease=crypto.randomUUID();
+    if(!must(await db.rpc('acquire_execution_lease',{p_token:lease}))) return json({error:'Worker already running'},409);
+    const status=must(await db.from('defi_worker_status').select('*').eq('id',1).single());
+    must(await db.from('defi_worker_status').update({last_started_at:new Date().toISOString(),last_error:null}).eq('id',1));
+    const failures:string[]=[];
+    const positions=must(await db.from('defi_positions').select('*').eq('enabled',true).limit(10)) ?? [];
+    for(const position of positions) {
+      try {
+        const protocol=position.protocol as Protocol, cfg=PROTOCOLS[protocol];
+        const rpc=makeRpc(Deno.env.get(`DEFI_RPC_${cfg.chain}`)??cfg.rpc,AbortSignal.timeout(20000));
+        const snapshot=await readProtocol(protocol,position.wallet,rpc,position.pool_ids);
+        await leaseValid(lease);
+        must(await db.from('defi_snapshots').upsert({position_id:position.id,block_number:snapshot.block,block_hash:snapshot.blockHash,snapshot},{onConflict:'position_id,block_number'}));
+        if(protocol==='compound') {
+          try {
+            const finalized = await rpc('eth_getBlockByNumber',['finalized',false]) as {number:string}|null;
+            if (!finalized) continue;
+            const history = must(await db.from('defi_snapshots').select('snapshot').eq('position_id',position.id).lte('block_number',Number(BigInt(finalized.number))).order('block_number',{ascending:false}).limit(2)) ?? [];
+            if(history.length < 2) continue;
+            const old=history[1].snapshot as ProtocolSnapshot;
+            const settled=history[0].snapshot as ProtocolSnapshot;
+            const yieldResult=await verifyCompoundAccrual(old,settled,rpc);
+            must(await db.from('defi_yield_intervals').upsert({position_id:position.id,asset:yieldResult.asset,from_block:old.block,to_block:settled.block,from_hash:old.blockHash,to_hash:settled.blockHash,raw_yield:yieldResult.rawYield,decimals:yieldResult.decimals,method:yieldResult.method,evidence:yieldResult.evidence},{onConflict:'position_id,asset,from_block,to_block'}));
+          } catch { failures.push(`${position.id}: yield interval unavailable; cashflow reconciliation required`); }
+        }
+      } catch(error) { failures.push(`${position.id}: ${error instanceof Error?error.message:'Read failed'}`); }
+    }
+    const freshStatus=must(await db.from('defi_worker_status').select('paused').eq('id',1).single());
+    await executeOne(lease,freshStatus?.paused !== false);
+    must(await db.from('defi_worker_status').update({last_completed_at:new Date().toISOString(),last_error:failures.join('; ')||null}).eq('id',1));
+    return json({checked:positions.length,failures,paused:status.paused});
+  } catch(error) {
+    const message=error instanceof Error?error.message:'Worker failed';
+    // Persist health failure without serializing signer responses, keys or signed bytes.
+    await db.from('defi_worker_status').update({last_error:message}).eq('id',1);
+    return json({error:message},503);
+  } finally { if(lease) await db.rpc('release_execution_lease',{p_token:lease}); }
+});
