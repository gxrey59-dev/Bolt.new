@@ -0,0 +1,36 @@
+import { Interface, parseUnits } from 'ethers';
+import { PROTOCOLS, type ProtocolSnapshot, type Rpc } from './protocols.ts';
+
+/** Token-denominated accrued interest, never projected APY or a USD profit claim.
+ * Fail closed on ANY wallet activity, debt, missing archive data or block reorg.
+ * Active intervals need transaction-level cost-basis reconciliation, not guessing.
+ */
+export async function verifyCompoundAccrual(previous: ProtocolSnapshot, current: ProtocolSnapshot, rpc: Rpc) {
+  if (previous.protocol !== 'compound' || current.protocol !== 'compound' || !previous.wallet || previous.wallet.toLowerCase() !== current.wallet?.toLowerCase()) throw new Error('Matching Compound wallet snapshots required');
+  const from = BigInt(previous.block), to = BigInt(current.block);
+  if (to <= from || to-from > 5000n) throw new Error('Accounting interval must be 1–5000 blocks');
+  if (previous.chain !== 8453 || current.chain !== 8453 || current.contract.toLowerCase() !== PROTOCOLS.compound.contract || previous.contract.toLowerCase() !== PROTOCOLS.compound.contract) throw new Error('Accounting contract mismatch');
+  const blocks = await Promise.all([rpc('eth_getBlockByNumber', ['0x'+from.toString(16),false]),rpc('eth_getBlockByNumber',['0x'+to.toString(16),false])]) as { hash: string }[];
+  if (blocks[0]?.hash !== previous.blockHash || blocks[1]?.hash !== current.blockHash) throw new Error('Reorganized accounting interval');
+  const finalized = await rpc('eth_getBlockByNumber', ['finalized', false]) as {number: string} | null;
+  if (!finalized || BigInt(finalized.number) < to) throw new Error('Accounting interval is not finalized');
+  const walletWord = previous.wallet.slice(2).toLowerCase().padStart(64,'0');
+  for (let start = from+1n; start <= to; start += 500n) {
+    const end = start+499n < to ? start+499n : to;
+    const logs = await rpc('eth_getLogs',[{ address: PROTOCOLS.compound.contract, fromBlock:'0x'+start.toString(16),toBlock:'0x'+end.toString(16) }]) as { topics:string[]; data:string; removed?:boolean }[];
+    if (!Array.isArray(logs)) throw new Error('Incomplete event history');
+    if (logs.some(log => log.removed || [...log.topics,log.data].some(value => value.toLowerCase().includes(walletWord)))) throw new Error('Wallet activity requires cashflow reconciliation; yield unknown');
+  }
+  const abi = new Interface(['function userBasic(address) view returns(int104,uint64,uint64,uint16,uint8)', 'function baseToken() view returns(address)','function decimals() view returns(uint8)']);
+  const call = async (contract:string, name:string, args:unknown[], block:bigint) => abi.decodeFunctionResult(name,String(await rpc('eth_call',[{to:contract,data:abi.encodeFunctionData(name,args)},'0x'+block.toString(16)])));
+  const [startPrincipal,endPrincipal,base] = await Promise.all([call(PROTOCOLS.compound.contract,'userBasic',[previous.wallet],from),call(PROTOCOLS.compound.contract,'userBasic',[previous.wallet],to),call(PROTOCOLS.compound.contract,'baseToken',[],to)]);
+  if (startPrincipal[0] < 0n || endPrincipal[0] !== startPrincipal[0]) throw new Error('Principal changed or debt present; yield unknown');
+  const [decimals] = await call(base[0],'decimals',[],to);
+  const before = previous.positions.find(p => p.kind === 'supply' && p.asset.toLowerCase() === base[0].toLowerCase());
+  const after = current.positions.find(p => p.kind === 'supply' && p.asset.toLowerCase() === base[0].toLowerCase());
+  if (!before || !after) throw new Error('Missing verified supply values');
+  const rawYield = parseUnits(after.amount,Number(decimals)) - parseUnits(before.amount,Number(decimals));
+  const canonical = await rpc('eth_getBlockByNumber',['0x'+to.toString(16),false]) as {hash:string};
+  if (canonical?.hash !== current.blockHash) throw new Error('Reorg during accounting');
+  return { asset:base[0].toLowerCase(), rawYield:rawYield.toString(), decimals:Number(decimals), method:'compound-supply-no-flow-accrual-v1', evidence:{principal:startPrincipal[0].toString(),fromHash:previous.blockHash,toHash:current.blockHash,logsComplete:true,realized:false} };
+}
