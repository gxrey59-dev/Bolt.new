new file mode 100644
index 0000000..adee262
--- /dev/null
+++ b/supabase/functions/_shared/defi-execution.ts
@@ -0,0 +1,112 @@
+import { Interface, Transaction, keccak256 } from 'ethers';
+import { PROTOCOLS, ERC20, address, type Protocol } from './protocols.ts';
+
+// Policies are provisioned by the operator on the server, never by the browser.
+// An exact calldata policy avoids granting a generic arbitrary-call wallet.
+export type ExecutionPolicy = {
+  chain: number; wallet: string; to: string; data: string; value: string;
+  maxGas: string; maxFeePerGas: string; expiresAt: number;
+};
+export type ExecutionIntent = ExecutionPolicy & { id: string; protocol: Protocol };
+export function validatePolicy(policy: ExecutionPolicy, now = Date.now()) {
+  if (!Object.values(PROTOCOLS).some(p => p.chain === policy.chain)) throw new Error('Unsupported chain');
+  address(policy.wallet); address(policy.to);
+  if (!/^0x([\da-f]{2})+$/i.test(policy.data) || policy.data.length < 10) throw new Error('Calldata is required');
+  for (const field of ['value', 'maxGas', 'maxFeePerGas'] as const) if (!/^\d+$/.test(policy[field])) throw new Error(`Invalid ${field}`);
+  if (BigInt(policy.maxGas) <= 0n || BigInt(policy.maxFeePerGas) <= 0n) throw new Error('Gas limits must be positive');
+  if (!Number.isSafeInteger(policy.expiresAt) || policy.expiresAt <= now) throw new Error('Policy expired');
+}
+export function verifySignedTransaction(raw: string, policy: ExecutionPolicy, now = Date.now()) {
+  validatePolicy(policy, now);
+  const tx = Transaction.from(raw);
+  if (!tx.signature || !tx.from || tx.type !== 2) throw new Error('Signed EIP-1559 transaction required');
+  if (tx.chainId !== BigInt(policy.chain) || tx.from.toLowerCase() !== policy.wallet.toLowerCase() || tx.to?.toLowerCase() !== policy.to.toLowerCase() || tx.data.toLowerCase() !== policy.data.toLowerCase() || tx.value !== BigInt(policy.value)) throw new Error('Signed transaction differs from approved policy');
+  if (tx.gasLimit <= 0n || tx.gasLimit > BigInt(policy.maxGas) || !tx.maxFeePerGas || tx.maxFeePerGas > BigInt(policy.maxFeePerGas) || tx.maxPriorityFeePerGas === null || tx.maxPriorityFeePerGas > tx.maxFeePerGas) throw new Error('Gas budget exceeded');
+  return { hash: keccak256(raw), nonce: tx.nonce, raw };
+}
+export type Action =
+  | { kind: 'approve'; asset: string; spender: string; amount: string }
+  | { kind: 'supply' | 'withdraw'; asset: string; amount: string }
+  | { kind: 'curve-add'; amounts: [string,string,string]; minLp: string }
+  | { kind: 'curve-remove'; lp: string; minAmounts: [string,string,string] }
+  | { kind: 'uni-increase'; tokenId: string; amount0: string; amount1: string; min0: string; min1: string; deadline: number }
+  | { kind: 'uni-decrease'; tokenId: string; liquidity: string; min0: string; min1: string; deadline: number }
+  | { kind: 'uni-collect'; tokenId: string; max0: string; max1: string }
+  | { kind: 'balancer-join'; poolId: string; assets: string[]; amounts: string[]; minLp: string }
+  | { kind: 'balancer-exit'; poolId: string; assets: string[]; minAmounts: string[]; lp: string };
+const uint = (v: string, positive = true) => {
+  if (!/^\d+$/.test(v) || (positive && BigInt(v) <= 0n)) throw new Error('Invalid positive raw token amount');
+  return BigInt(v);
+};
+// This prepares bytes only. On-chain checks and human/server approval are separate;
+// it never submits or signs transactions and never invents a liquidity quote.
+export function encodeAction(protocol: Protocol, walletInput: string, action: Action, resolvedAavePool?: string) {
+  const wallet = address(walletInput);
+  let to: string = PROTOCOLS[protocol].contract;
+  const encode = (signature: string, args: unknown[]) => {
+    const abi = new Interface([signature]);
+    return { to, data: abi.encodeFunctionData(abi.fragments[0].format(), args), value: '0', chain: PROTOCOLS[protocol].chain };
+  };
+  if (action.kind === 'approve') {
+    const spender = address(action.spender);
+    const allowedSpender = protocol === 'aave' ? address(resolvedAavePool ?? '') : to;
+    if (spender.toLowerCase() !== allowedSpender.toLowerCase()) throw new Error('Approval spender does not match protocol');
+    to = address(action.asset);
+    return { to, data: ERC20.encodeFunctionData('approve', [spender, uint(action.amount, false)]), value: '0', chain: PROTOCOLS[protocol].chain };
+  }
+  if (protocol === 'aave' && (action.kind === 'supply' || action.kind === 'withdraw')) {
+    to = address(resolvedAavePool ?? '');
+    const asset = address(action.asset), amount = uint(action.amount);
+    return action.kind === 'supply'
+      ? encode('function supply(address,uint256,address,uint16)', [asset, amount, wallet, 0])
+      : encode('function withdraw(address,uint256,address)', [asset, amount, wallet]);
+  }
+  if (protocol === 'compound' && (action.kind === 'supply' || action.kind === 'withdraw')) {
+    return encode(`function ${action.kind}(address,uint256)`, [address(action.asset), uint(action.amount)]);
+  }
+  if (protocol === 'curve' && action.kind === 'curve-add') {
+    if (!action.amounts.some(v => uint(v, false) > 0n)) throw new Error('Empty deposit');
+    return encode('function add_liquidity(uint256[3],uint256)', [action.amounts.map(v => uint(v, false)), uint(action.minLp)]);
+  }
+  if (protocol === 'curve' && action.kind === 'curve-remove') return encode('function remove_liquidity(uint256,uint256[3])', [uint(action.lp), action.minAmounts.map(v => uint(v))]);
+  if (protocol === 'uniswap') {
+    if (action.kind === 'uni-increase' || action.kind === 'uni-decrease') {
+      if (!Number.isSafeInteger(action.deadline) || action.deadline <= Date.now()/1000 || action.deadline > Date.now()/1000 + 900) throw new Error('Deadline must be within 15 minutes');
+      if (action.kind === 'uni-increase') return encode('function increaseLiquidity((uint256,uint256,uint256,uint256,uint256,uint256))', [[uint(action.tokenId), uint(action.amount0, false), uint(action.amount1, false), uint(action.min0), uint(action.min1), action.deadline]]);
+      return encode('function decreaseLiquidity((uint256,uint128,uint256,uint256,uint256))', [[uint(action.tokenId), uint(action.liquidity), uint(action.min0), uint(action.min1), action.deadline]]);
+    }
+    if (action.kind === 'uni-collect') return encode('function collect((uint256,address,uint128,uint128))', [[uint(action.tokenId), wallet, uint(action.max0, false), uint(action.max1, false)]]);
+  }
+  // Weighted V2 pools only; composable/stable pools have different join/exit kinds.
+  // The backend must whitelist the exact audited pool, ordered assets and calldata.
+  if (protocol === 'balancer' && (action.kind === 'balancer-join' || action.kind === 'balancer-exit')) {
+    if (!/^0x[\da-f]{64}$/i.test(action.poolId)) throw new Error('Invalid pool ID');
+    const assets = action.assets.map(address);
+    if (assets.length < 2 || new Set(assets).size !== assets.length) throw new Error('Invalid assets');
+    const values = action.kind === 'balancer-join' ? action.amounts : action.minAmounts;
+    if (values.length !== assets.length) throw new Error('Asset/amount length mismatch');
+    const amounts = values.map(v => uint(v));
+    const coder = ERC20.getAbiCoder();
+    if (action.kind === 'balancer-join') {
+      const data = coder.encode(['uint256','uint256[]','uint256'], [1, amounts, uint(action.minLp)]);
+      return encode('function joinPool(bytes32,address,address,(address[],uint256[],bytes,bool))', [action.poolId, wallet, wallet, [assets, amounts, data, false]]);
+    }
+    const data = coder.encode(['uint256','uint256'], [1, uint(action.lp)]);
+    return encode('function exitPool(bytes32,address,address,(address[],uint256[],bytes,bool))', [action.poolId, wallet, wallet, [assets, amounts, data, false]]);
+  }
+  throw new Error('Action does not match protocol');
+}
+
+export function receiptTransfers(receipt: { logs: { address: string; topics: string[]; data: string; logIndex: string }[] }, wallet: string) {
+  const normalized = address(wallet).toLowerCase();
+  return receipt.logs.flatMap(log => {
+    try {
+      const event = ERC20.parseLog(log);
+      if (!event || event.name !== 'Transfer' || log.topics.length !== 3) return [];
+      const from = String(event.args.from).toLowerCase(), to = String(event.args.to).toLowerCase();
+      if (from !== normalized && to !== normalized) return [];
+      const delta = (to === normalized ? event.args.value : 0n) - (from === normalized ? event.args.value : 0n);
+      return [{ asset: address(log.address).toLowerCase(), rawDelta: delta.toString(), logIndex: Number(BigInt(log.logIndex)) }];
+    } catch { return []; } // NFT transfers and unrelated logs are not ERC20 cashflow.
+  });
+}
diff --git a/supabase/functions/_shared/protocols.ts b/supabase/functions/_shared/protocols.ts
new file mode 100644
index 0000000..f30b695
--- /dev/null
+++ b/supabase/functions/_shared/protocols.ts
@@ -0,0 +1,124 @@
+import { Interface, getAddress, formatUnits } from 'ethers';
+
+export const PROTOCOLS = {
+  curve: { chain: 1, rpc: 'https://ethereum-rpc.publicnode.com', contract: '0xbebc44782c7db0a1a60cb6fe97d0b483032ff1c7', label: 'Curve 3pool' },
+  uniswap: { chain: 42161, rpc: 'https://arbitrum-one-rpc.publicnode.com', contract: '0xc36442b4a4522e871399cd717abdd847ab11fe88', label: 'Uniswap V3' },
+  aave: { chain: 137, rpc: 'https://polygon-bor-rpc.publicnode.com', contract: '0xa97684ead0e402dc232d5a977953df7ecbaB3cdb'.toLowerCase(), label: 'Aave V3' },
+  balancer: { chain: 10, rpc: 'https://optimism-rpc.publicnode.com', contract: '0xba12222222228d8ba445958a75a0704d566bf2c8', label: 'Balancer V2' },
+  compound: { chain: 8453, rpc: 'https://base-rpc.publicnode.com', contract: '0xb125e6687d4313864e53df431d5425969c15eb2f', label: 'Compound III USDC' },
+} as const;
+export type Protocol = keyof typeof PROTOCOLS;
+export type Rpc = (method: string, params: unknown[]) => Promise<unknown>;
+export type Position = { asset: string; amount: string; unit: string; kind: 'supply' | 'debt' | 'liquidity' | 'owed'; };
+export type ProtocolSnapshot = {
+  protocol: Protocol; chain: number; block: string; blockHash: string; timestamp: number;
+  wallet: string | null; contract: string; positions: Position[]; details: string[];
+  // No USD sum: LP balances, principal, fees and oracle collateral are different measures.
+  positionsComplete: boolean;
+};
+export function address(value: string): string {
+  const result = getAddress(value);
+  if (/^0x0{40}$/i.test(result)) throw new Error('A nonzero wallet/contract address is required');
+  return result;
+}
+export function makeRpc(url: string, signal: AbortSignal): Rpc {
+  let id = 0;
+  return async (method, params) => {
+    const requestId = ++id;
+    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ jsonrpc: '2.0', id: requestId, method, params }), signal });
+    if (!res.ok) throw new Error(`RPC HTTP ${res.status}`);
+    const data = await res.json();
+    if (data.id !== requestId || data.error || !('result' in data)) throw new Error(data.error?.message ?? 'Invalid RPC response');
+    return data.result;
+  };
+}
+export const ERC20 = new Interface(['function balanceOf(address) view returns(uint256)', 'function decimals() view returns(uint8)', 'function allowance(address,address) view returns(uint256)', 'function approve(address,uint256) returns(bool)', 'function totalSupply() view returns(uint256)', 'event Transfer(address indexed from,address indexed to,uint256 value)']);
+export async function readProtocol(protocol: Protocol, walletInput: string, rpc: Rpc, poolIds: string[] = []): Promise<ProtocolSnapshot> {
+  const config = PROTOCOLS[protocol];
+  const wallet = walletInput ? address(walletInput) : null;
+  if (Number(BigInt(String(await rpc('eth_chainId', [])))) !== config.chain) throw new Error('RPC chain mismatch');
+  const block = await rpc('eth_getBlockByNumber', ['latest', false]) as { number: string; hash: string; timestamp: string };
+  if (!block || !/^0x[\da-f]{64}$/i.test(block.hash)) throw new Error('Missing block identity');
+  const timestamp = Number(BigInt(block.timestamp)) * 1000;
+  if (Date.now() - timestamp > 180000 || timestamp > Date.now() + 30000) throw new Error('Stale RPC block');
+  const call = async (contract: string, signature: string, args: unknown[] = []) => {
+    const abi = new Interface([signature]);
+    const fragment = abi.fragments[0];
+    const raw = await rpc('eth_call', [{ to: contract, data: abi.encodeFunctionData(fragment.format(), args) }, block.number]);
