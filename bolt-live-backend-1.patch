diff --git a/src/components/OrderRecoveryPanel.tsx b/src/components/OrderRecoveryPanel.tsx
new file mode 100644
index 0000000..bf7c7b0
--- /dev/null
+++ b/src/components/OrderRecoveryPanel.tsx
@@ -0,0 +1,41 @@
+import { useCallback, useEffect, useState } from 'react';
+import { supabase } from '@/lib/supabase';
+import { authenticatedFetch } from '@/lib/api';
+
+type ExitOrder = { client_order_id: string; symbol: string; state: string; error: string | null };
+export default function OrderRecoveryPanel() {
+  const [orders, setOrders] = useState<ExitOrder[]>([]);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [message, setMessage] = useState('');
+  const load = useCallback(async () => {
+    const { data, error } = await supabase.from('execution_orders').select('client_order_id,symbol,state,error')
+      .in('state', ['pending', 'filled', 'unknown']).order('created_at');
+    if (error) { setMessage('Order recovery unavailable. Complete the database deployment before trading.'); return; }
+    setOrders(data ?? []);
+  }, []);
+  useEffect(() => { void load(); const timer = setInterval(() => void load(), 10000); return () => clearInterval(timer); }, [load]);
+  async function reconcile(id: string) {
+    setBusy(id); setMessage('');
+    try {
+      const response = await authenticatedFetch(`${import.meta.env.VITE_SUPABASE_URL}/functions/v1/binance-feed/reconcile`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ clientOrderId: id }),
+      });
+      const result = await response.json();
+      setMessage(result.error ?? result.message ?? result.state);
+      await load();
+    } catch { setMessage('Could not verify the exchange order. It remains unresolved.'); }
+    finally { setBusy(null); }
+  }
+  if (!orders.length && !message) return null;
+  return <section className="rounded-xl border border-amber-600/40 p-4 text-sm text-amber-200">
+    <h2 className="font-semibold">Exchange orders requiring reconciliation</h2>
+    <p className="my-2 text-xs">Recovery checks existing fills and updates records. It does not submit another trade.</p>
+    {message && <p role="status" className="my-2">{message}</p>}
+    {orders.map(order => <div key={order.client_order_id} className="my-3 space-y-1">
+      <p>{order.symbol} · {order.state}</p><p className="text-xs">{order.error}</p>
+      <button disabled={busy !== null} className="rounded bg-zinc-700 px-3 py-2 disabled:opacity-50" onClick={() => void reconcile(order.client_order_id)}>
+        {busy === order.client_order_id ? 'Checking exchange…' : 'Reconcile existing order'}
+      </button>
+    </div>)}
+  </section>;
+}
