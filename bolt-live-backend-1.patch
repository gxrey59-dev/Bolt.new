+++ b/tests/defi-execution.test.mjs
@@ -0,0 +1,40 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { Wallet, Interface } from 'ethers';
+const {outputFiles}=await build({entryPoints:['supabase/functions/_shared/defi-execution.ts'],bundle:true,write:false,platform:'node',format:'esm'});
+const {encodeAction,verifySignedTransaction,receiptTransfers}=await import('data:text/javascript;base64,'+Buffer.from(outputFiles[0].text).toString('base64'));
+// Ephemeral offline fixture: this signer never connects to a network.
+const wallet=Wallet.createRandom();
+const asset='0x'+'1'.repeat(40), pool='0x'+'2'.repeat(40);
+const intent=encodeAction('aave',wallet.address,{kind:'supply',asset,amount:'1000000'},pool);
+const policy={...intent,wallet:wallet.address,maxGas:'300000',maxFeePerGas:'10000000000',expiresAt:Date.now()+60000};
+const transaction={type:2,chainId:137,to:intent.to,data:intent.data,value:0,nonce:7,gasLimit:200000,maxFeePerGas:1000000000,maxPriorityFeePerGas:100000000};
+test('signed execution must match approved wallet, chain, calldata, value and gas',async()=>{
+ const raw=await wallet.signTransaction(transaction);
+ assert.equal(verifySignedTransaction(raw,policy).nonce,7);
+ for(const [field,value] of [['chain',1],['wallet',asset],['to',asset],['data','0x12345678'],['value','1'],['maxGas','1'],['maxFeePerGas','1'],['expiresAt',0]]) assert.throws(()=>verifySignedTransaction(raw,{...policy,[field]:value}));
+ const changed=await wallet.signTransaction({...transaction,nonce:8,data:'0x12345678'});
+ assert.throws(()=>verifySignedTransaction(changed,policy));
+});
+test('all protocol encoders have bounded amounts, receivers and slippage floors',()=>{
+ assert.throws(()=>encodeAction('aave',wallet.address,{kind:'approve',asset,spender:asset,amount:'1'},pool));
+ assert.throws(()=>encodeAction('curve',wallet.address,{kind:'curve-add',amounts:['0','1','0'],minLp:'0'}));
+ const curve=encodeAction('curve',wallet.address,{kind:'curve-add',amounts:['0','1','0'],minLp:'1'});
+ const compound=encodeAction('compound',wallet.address,{kind:'supply',asset,amount:'1'});
+ const uni=encodeAction('uniswap',wallet.address,{kind:'uni-collect',tokenId:'1',max0:'1',max1:'1'});
+ const balancer=encodeAction('balancer',wallet.address,{kind:'balancer-join',poolId:'0x'+'3'.repeat(64),assets:[asset,pool],amounts:['1','2'],minLp:'1'});
+ assert.deepEqual([curve.chain,compound.chain,uni.chain,balancer.chain],[1,8453,42161,10]);
+ const collect=new Interface(['function collect((uint256,address,uint128,uint128))']).decodeFunctionData('collect',uni.data);
+ assert.equal(collect[0][1],wallet.address);
+ assert.throws(()=>encodeAction('uniswap',wallet.address,{kind:'uni-decrease',tokenId:'1',liquidity:'1',min0:'1',min1:'1',deadline:1}));
+ assert.throws(()=>encodeAction('compound',wallet.address,{kind:'curve-add',amounts:['1','0','0'],minLp:'1'}));
+});
+test('receipt accounting records actual ERC20 deltas and ignores NFTs, without calling deposits income',()=>{
+ const abi=new Interface(['event Transfer(address indexed from,address indexed to,uint256 value)']);
+ const inbound=abi.encodeEventLog('Transfer',[asset,wallet.address,123n]);
+ const outbound=abi.encodeEventLog('Transfer',[wallet.address,asset,12n]);
+ const flows=receiptTransfers({logs:[{...inbound,address:asset,logIndex:'0x0'},{...outbound,address:asset,logIndex:'0x1'},{topics:[...inbound.topics,'0x'+'0'.repeat(64)],data:'0x',address:pool,logIndex:'0x2'}]},wallet.address);
+ assert.deepEqual(flows.map(f=>f.rawDelta),['123','-12']);
+ assert.equal(flows.some(f=>'profit' in f),false);
+});
