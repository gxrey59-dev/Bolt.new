diff --git a/src/components/AuthGate.tsx b/src/components/AuthGate.tsx
new file mode 100644
index 0000000..d65c675
--- /dev/null
+++ b/src/components/AuthGate.tsx
@@ -0,0 +1,50 @@
+import { useEffect, useState, type FormEvent, type ReactNode } from 'react';
+import { supabase, isSupabaseConfigured } from '@/lib/supabase';
+
+export default function AuthGate({ children }: { children: ReactNode }) {
+  const [ready, setReady] = useState(false);
+  const [allowed, setAllowed] = useState(false);
+  const [email, setEmail] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+  useEffect(() => {
+    if (!isSupabaseConfigured) return;
+    let active = true;
+    let generation = 0;
+    async function check() {
+      const current = ++generation;
+      const { data } = await supabase.auth.getSession();
+      const result = data.session ? await supabase.rpc('is_app_operator') : null;
+      if (!active || current !== generation) return;
+      setAllowed(result?.data === true && !result.error);
+      if (data.session && (result?.error || result?.data !== true)) setError('This account is not configured as the owner. Complete the owner setup before using this dashboard.');
+      setReady(true);
+    }
+    void check();
+    const { data: listener } = supabase.auth.onAuthStateChange(() => { setTimeout(() => void check(), 0); });
+    return () => { active = false; listener.subscription.unsubscribe(); };
+  }, []);
+  async function signIn(event: FormEvent) {
+    event.preventDefault(); setBusy(true); setError('');
+    try {
+      const { error } = await supabase.auth.signInWithPassword({ email, password });
+      if (error) setError(error.message);
+      setPassword('');
+    } catch { setError('Sign-in unavailable. Try again.'); }
+    finally { setBusy(false); }
+  }
+  if (!isSupabaseConfigured) return <p role="alert" className="p-8 text-amber-200">Setup required: configure the Supabase project URL and public key for this app.</p>;
+  if (!ready) return <p className="p-8 text-zinc-300">Checking access…</p>;
+  if (allowed) return <><div className="flex justify-end bg-zinc-950 px-6 py-2"><button className="text-sm text-zinc-400" onClick={() => void supabase.auth.signOut()}>Sign out</button></div>{children}</>;
+  return <main className="min-h-screen bg-zinc-950 p-6 text-zinc-100 flex items-center justify-center">
+    <form onSubmit={signIn} className="w-full max-w-sm space-y-5 rounded-xl border border-zinc-700 p-6">
+      <h1 className="text-xl font-semibold">Owner sign-in</h1>
+      <p className="text-sm text-zinc-400">Sign in to your configured owner account to view trading data and controls.</p>
+      <label className="block">Email<input className="mt-1 w-full rounded bg-zinc-800 p-2" type="email" autoComplete="username" required value={email} onChange={e => setEmail(e.target.value)} /></label>
+      <label className="block">Password<input className="mt-1 w-full rounded bg-zinc-800 p-2" type="password" autoComplete="current-password" required value={password} onChange={e => setPassword(e.target.value)} /></label>
+      {error && <p role="alert" className="text-sm text-red-300">{error}</p>}
+      <button disabled={busy} className="w-full rounded bg-blue-600 p-2 disabled:opacity-50">{busy ? 'Signing in…' : 'Sign in'}</button>
+    </form>
+  </main>;
+}
