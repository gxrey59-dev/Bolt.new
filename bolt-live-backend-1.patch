@@ -0,0 +1,52 @@
+export const LIVE_ENTRY_BLOCK_REASON = "New live entries are disabled pending exchange reconciliation and deployment verification. Paper trading and authenticated exits remain available.";
+// Deliberate release gate: cannot be bypassed by changing a browser/DB setting.
+export const LIVE_ENTRIES_ENABLED = false;
+
+export function stepDecimals(step: number): number {
+  if (!Number.isFinite(step) || step <= 0) throw new Error("Invalid quantity step");
+  const [coefficient, exponent = "0"] = step.toString().toLowerCase().split("e");
+  return Math.max(0, (coefficient.split(".")[1]?.length ?? 0) - Number(exponent));
+}
+export function floorQuantity(value: number, step: number): number {
+  if (!Number.isFinite(value) || value <= 0) throw new Error("Invalid quantity");
+  const decimals = stepDecimals(step);
+  return Number((Math.floor(value / step + 1e-9) * step).toFixed(decimals));
+}
+export function finitePositive(value: unknown, label: string): number {
+  const n = Number(value);
+  if (!Number.isFinite(n) || n <= 0) throw new Error(`Invalid ${label}`);
+  return n;
+}
+export function dailyLossState(loss: number, resetAt: string | null, now = Date.now()) {
+  const elapsed = resetAt ? now - Date.parse(resetAt) : Infinity;
+  return !Number.isFinite(elapsed) || elapsed >= 86400000
+    ? { loss: 0, resetAt: new Date(now).toISOString() }
+    : { loss, resetAt: resetAt! };
+}
+export interface ExchangeFill {
+  price: string; qty: string; commission: string; commissionAsset: string;
+}
+export interface ExchangeOrder {
+  orderId?: number | string; status?: string; executedQty?: string;
+  cummulativeQuoteQty?: string; fills?: ExchangeFill[];
+}
+export function confirmedFill(order: ExchangeOrder, baseAsset: string, side: "BUY" | "SELL") {
+  if (!order.orderId || order.status !== "FILLED") throw new Error("Order is not confirmed FILLED; reconcile before retrying");
+  const executed = finitePositive(order.executedQty, "executed quantity");
+  const quote = finitePositive(order.cummulativeQuoteQty, "executed quote amount");
+  if (!Array.isArray(order.fills) || !order.fills.length) throw new Error("Missing fills/commissions; reconcile before retrying");
+  let baseFee = 0, quoteFee = 0, filledQty = 0;
+  for (const fill of order.fills) {
+    filledQty += finitePositive(fill.qty, "fill quantity");
+    const fee = Number(fill.commission);
+    if (!Number.isFinite(fee) || fee < 0) throw new Error("Invalid commission");
+    if (fill.commissionAsset === baseAsset) baseFee += fee;
+    else if (fill.commissionAsset === "USDT") quoteFee += fee;
+    else if (fee > 0) throw new Error("Third-asset commission needs valuation; reconcile before retrying");
+  }
+  if (Math.abs(filledQty - executed) > Math.max(1e-10, executed * 1e-8)) throw new Error("Incomplete fill list");
+  const quantity = side === "BUY" ? executed - baseFee : executed + baseFee;
+  if (quantity <= 0) throw new Error("Invalid net fill quantity");
+  return { orderId: String(order.orderId), quantity, price: quote / executed,
+    quote: side === "BUY" ? quote + quoteFee : quote - quoteFee };
+}
diff --git a/supabase/functions/_shared/yield-accounting.ts b/supabase/functions/_shared/yield-accounting.ts
