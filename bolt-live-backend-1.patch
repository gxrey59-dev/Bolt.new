--- /dev/null
+++ b/tests/defi-live.test.mjs
@@ -0,0 +1,56 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { build } from 'esbuild';
+const source = await readFile(new URL('../src/components/DeFiSwarmPanel.tsx', import.meta.url), 'utf8');
+const { outputFiles } = await build({ stdin: { contents: source + '\nexport { readSnapshot };', resolveDir: process.cwd() + '/src/components', loader: 'tsx' }, bundle: true, write: false, format: 'esm', platform: 'browser', define: { 'import.meta.env': '{}' }, alias: { '@': process.cwd() + '/src' } });
+const { readSnapshot } = await import('data:text/javascript;base64,' + Buffer.from(outputFiles[0].text).toString('base64'));
+const pool = '0x' + '1'.repeat(40), oracle = '0x' + '2'.repeat(40), wallet = '0x' + '3'.repeat(40);
+const word = value => BigInt(value).toString(16).padStart(64, '0');
+function transport(overrides = {}) {
+  const calls = [];
+  const request = async (method, params) => {
+    calls.push({ method, params });
+    if (method in overrides) return overrides[method];
+    if (method === 'eth_chainId') return '0x89';
+    if (method === 'eth_blockNumber') return '0x123';
+    if (method === 'eth_getBlockByNumber') return { number: '0x123', timestamp: '0x' + Math.floor(Date.now() / 1000).toString(16) };
+    if (method === 'eth_getCode') return '0x60016001';
+    if (method === 'eth_getBalance') return '0x' + (3n * 10n ** 18n).toString(16);
+    if (method === 'eth_call') {
+      const data = params[0].data;
+      if (data === '0x026b1d5f') return '0x' + pool.slice(2).padStart(64, '0');
+      if (data === '0xfca513a8') return '0x' + oracle.slice(2).padStart(64, '0');
+      if (data === '0x8c89b64f') return '0x' + word(100000000);
+      if (data === '0xe19f4700') return '0x' + word(0);
+      if (data.startsWith('0xbf92857c')) return '0x' + [12345000000n, 4000000000n, 0n, 8000n, 7000n, 2469n * 10n ** 15n].map(word).join('');
+    }
+    throw new Error('Unexpected RPC call: ' + method);
+  };
+  return { calls, request };
+}
+test('Aave reads use a single verified block and never submit transactions', async () => {
+  const { request, calls } = transport();
+  const result = await readSnapshot(request, wallet, new AbortController().signal);
+  assert.equal(result.collateral, '123.45'); assert.equal(result.debt, '40');
+  assert.equal(result.nativeBalance, '3'); assert.equal(result.health, '2.469');
+  assert.equal(result.currency, 'USD'); assert.equal(result.wallet, wallet);
+  for (const call of calls.filter(call => ['eth_call','eth_getCode','eth_getBalance'].includes(call.method))) assert.equal(call.params[1], '0x123');
+  assert.ok(calls.every(call => !/send|sign|approve/i.test(call.method)));
+});
+test('No wallet means unknown balances, not zero holdings', async () => {
+  const { request, calls } = transport();
+  const result = await readSnapshot(request, '', new AbortController().signal);
+  assert.equal(result.collateral, null); assert.equal(result.wallet, null);
+  assert.ok(!calls.some(call => call.method === 'eth_getBalance'));
+});
+test('Wrong network, stale blocks and missing bytecode fail closed', async () => {
+  for (const override of [{ eth_chainId: '0x1' }, { eth_getBlockByNumber: { number: '0x123', timestamp: '0x1' } }, { eth_getCode: '0x' }]) {
+    await assert.rejects(readSnapshot(transport(override).request, '', new AbortController().signal));
+  }
+});
+test('Invalid wallet input performs no network request', async () => {
+  const { request, calls } = transport();
+  await assert.rejects(readSnapshot(request, '0x123', new AbortController().signal));
+  assert.equal(calls.length, 0);
+});
diff --git a/tests/defi-protocols.test.mjs b/tests/defi-protocols.test.mjs
