--- /dev/null
+++ b/supabase/functions/_shared/auth.ts
@@ -0,0 +1,26 @@
+import type { SupabaseClient } from "npm:@supabase/supabase-js@2.57.4";
+
+/** Gateway JWT verification stays off to support the separately authenticated cron.
+ * Every handler must call this BEFORE reading account data or performing writes.
+ */
+export async function authorize(
+  req: Request, db: SupabaseClient, headers: Record<string, string>, allowScheduler = false,
+): Promise<Response | null> {
+  const deny = (status: number, error: string) => new Response(JSON.stringify({ error }), {
+    status, headers: { ...headers, "Content-Type": "application/json" },
+  });
+  const schedulerToken = Deno.env.get("SCHEDULER_TOKEN");
+  if (allowScheduler && schedulerToken && schedulerToken.length >= 32 &&
+      req.headers.get("X-Scheduler-Token") === schedulerToken) return null;
+  const token = req.headers.get("Authorization")?.match(/^Bearer (.+)$/i)?.[1];
+  if (!token) return deny(401, "Sign in to continue");
+  try {
+    const { data, error } = await db.auth.getUser(token);
+    if (error || !data.user) return deny(401, "Session expired; sign in again");
+    const membership = await db.from("app_operators").select("user_id").eq("user_id", data.user.id).maybeSingle();
+    if (membership.error || !membership.data) return deny(403, "Owner access required");
+    return null;
+  } catch {
+    return deny(503, "Cannot verify access; request blocked");
+  }
+}
