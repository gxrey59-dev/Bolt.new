+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {build} from 'esbuild';
+import {Interface} from 'ethers';
+const {outputFiles}=await build({entryPoints:['supabase/functions/_shared/yield-accounting.ts'],bundle:true,write:false,platform:'node',format:'esm'});
+const {verifyCompoundAccrual}=await import('data:text/javascript;base64,'+Buffer.from(outputFiles[0].text).toString('base64'));
+const contract='0xb125e6687d4313864e53df431d5425969c15eb2f',wallet='0x'+'1'.repeat(40),asset='0x'+'2'.repeat(40),hash='0x'+'a'.repeat(64);
+const old={protocol:'compound',wallet,chain:8453,contract,block:'10',blockHash:hash,positions:[{asset,amount:'100.0',kind:'supply'}]};
+const current={...old,block:'20',positions:[{asset,amount:'100.001',kind:'supply'}]};
+function rpc(options={}) {
+ const abi=new Interface(['function userBasic(address) view returns(int104,uint64,uint64,uint16,uint8)','function baseToken() view returns(address)','function decimals() view returns(uint8)']);
+ return async(method,params)=>{
+  if(method==='eth_getBlockByNumber') return {hash:options.reorg?'0x'+'b'.repeat(64):hash,number:options.unfinalized?'0x11':'0x20'};
+  if(method==='eth_getLogs') return options.activity?[{topics:['0x'+wallet.slice(2).padStart(64,'0')],data:'0x'}]:[];
+  if(method==='eth_call') {
+   const fn=abi.parseTransaction({data:params[0].data}).name;
+   return abi.encodeFunctionResult(fn,fn==='baseToken'?[asset]:fn==='decimals'?[6]:[options.debt?-1:options.principalChanged&&params[1]==='0x14'?101:100,0,0,0,0]);
+  }
+  throw Error('Unexpected method');
+ };
+}
+test('finalized no-flow supply interest is exact and token-denominated',async()=>{
+ const r=await verifyCompoundAccrual(old,current,rpc());
+ assert.equal(r.rawYield,'1000');assert.equal(r.decimals,6);assert.equal(r.evidence.realized,false);
+});
