+++ b/tests/defi-protocols.test.mjs
@@ -0,0 +1,34 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {build} from 'esbuild';
+import {Interface} from 'ethers';
+const {outputFiles}=await build({entryPoints:['supabase/functions/_shared/protocols.ts'],bundle:true,write:false,platform:'node',format:'esm'});
+const {PROTOCOLS,readProtocol}=await import('data:text/javascript;base64,'+Buffer.from(outputFiles[0].text).toString('base64'));
+function transport(protocol,options={}) {
+ const block={number:'0x100',hash:'0x'+'a'.repeat(64),timestamp:'0x'+Math.floor(Date.now()/1000).toString(16)};
+ const abi=new Interface(['function get_virtual_price() view returns(uint256)','function getPausedState() view returns(bool,uint256,uint256)','function getPool() view returns(address)','function baseToken() view returns(address)','function decimals() view returns(uint8)','function getUtilization() view returns(uint256)','function getSupplyRate(uint256) view returns(uint64)','function balanceOf(address) view returns(uint256)','function borrowBalanceOf(address) view returns(uint256)']);
+ const calls=[];
+ return {calls, rpc:async(method,params)=>{
+  calls.push({method,params});
+  if(method==='eth_chainId') return '0x'+(options.wrongChain?999:PROTOCOLS[protocol].chain).toString(16);
+  if(method==='eth_getBlockByNumber') return {...block,...(options.stale?{timestamp:'0x1'}:{}),...(options.reorg&&params[0]!=='latest'?{hash:'0x'+'b'.repeat(64)}:{})};
+  if(method==='eth_getCode') return options.noCode?'0x':'0x6000';
+  if(method==='eth_call') {
+   const call=abi.parseTransaction({data:params[0].data});
+   const values={get_virtual_price:[10n**18n],getPausedState:[false,0,0],getPool:['0x'+'2'.repeat(40)],baseToken:['0x'+'3'.repeat(40)],decimals:[6],getUtilization:[1],getSupplyRate:[1],balanceOf:[0],borrowBalanceOf:[0]};
+   return abi.encodeFunctionResult(call.name,values[call.name]);
+  }
+  throw new Error('Unexpected RPC method '+method);
+ }};
+}
+for(const protocol of Object.keys(PROTOCOLS)) test(`${protocol} validates mainnet, code, freshness and block identity`,async()=>{
+ const t=transport(protocol);const snapshot=await readProtocol(protocol,'',t.rpc);
+ assert.equal(snapshot.wallet,null);assert.equal(snapshot.positions.length,0);
+ assert.equal(t.calls.some(c=>c.method.includes('send')||c.method.includes('sign')),false);
+ for(const options of [{wrongChain:true},{noCode:true},{stale:true},{reorg:true}]) await assert.rejects(readProtocol(protocol,'',transport(protocol,options).rpc));
+});
+test('Compound zero holdings are returned only after a real wallet query',async()=>{
+ const t=transport('compound');const s=await readProtocol('compound','0x'+'4'.repeat(40),t.rpc);
+ assert.equal(s.positions[0].amount,'0.0');assert.equal(s.positions[1].kind,'debt');
+ for(const c of t.calls.filter(c=>c.method==='eth_call')) assert.equal(c.params[1],'0x100');
+});
