@@ -0,0 +1,132 @@
+-- Security and execution repair. Intentionally fail closed on deployment.
+CREATE TABLE IF NOT EXISTS public.app_operators (
+  user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE
+);
+ALTER TABLE public.app_operators ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON public.app_operators FROM anon, authenticated;
+GRANT ALL ON public.app_operators TO service_role;
+
+CREATE OR REPLACE FUNCTION public.is_app_operator() RETURNS boolean
+LANGUAGE sql STABLE SECURITY DEFINER SET search_path = '' AS $$
+  SELECT EXISTS (SELECT 1 FROM public.app_operators WHERE user_id = auth.uid());
+$$;
+REVOKE ALL ON FUNCTION public.is_app_operator() FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.is_app_operator() TO authenticated, service_role;
+
+-- Remove the old unrestricted policies; do not merely add restrictive-looking ones.
+DO $$
+DECLARE t text; p record;
+BEGIN
+  FOREACH t IN ARRAY ARRAY['factions','managers','signals','sweeps','circuit_breakers',
+    'sentiment','stress_tests','rotation_batches','audit_log','withdrawal_config',
+    'withdrawals','withdrawal_routes','market_data','paper_trades','strategy_config',
+    'backtest_runs','backtest_trades','nft_collection','defi_swarms','defi_swarm_agents','revenue_streams']
+  LOOP
+    FOR p IN SELECT policyname FROM pg_policies WHERE schemaname='public' AND tablename=t LOOP
+      EXECUTE format('DROP POLICY %I ON public.%I', p.policyname, t);
+    END LOOP;
+    EXECUTE format('REVOKE ALL ON public.%I FROM PUBLIC, anon, authenticated', t);
+    EXECUTE format('GRANT SELECT ON public.%I TO authenticated', t);
+    EXECUTE format('GRANT ALL ON public.%I TO service_role', t);
+    EXECUTE format('CREATE POLICY owner_read ON public.%I FOR SELECT TO authenticated USING (public.is_app_operator())', t);
+  END LOOP;
+  -- Only non-execution UI settings may be written directly by the verified owner.
+  FOREACH t IN ARRAY ARRAY['sentiment','withdrawal_config','nft_collection'] LOOP
+    EXECUTE format('GRANT INSERT, UPDATE, DELETE ON public.%I TO authenticated', t);
+    EXECUTE format('CREATE POLICY owner_write ON public.%I FOR ALL TO authenticated USING (public.is_app_operator()) WITH CHECK (public.is_app_operator())', t);
+  END LOOP;
+END $$;
+
+UPDATE public.strategy_config SET paper_mode=true, kill_switch=true,
+  kill_switch_reason='Safety repair deployed: review configuration and existing exchange positions before resuming',
+  kill_switch_tripped_at=now() WHERE id=1;
+
+-- One serialized execution lease, shared by scans and explicit closes.
+CREATE TABLE public.execution_lease (id integer PRIMARY KEY CHECK(id=1), token uuid NOT NULL, expires_at timestamptz NOT NULL);
+ALTER TABLE public.execution_lease ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON public.execution_lease FROM PUBLIC, anon, authenticated;
+GRANT ALL ON public.execution_lease TO service_role;
+CREATE FUNCTION public.acquire_execution_lease(p_token uuid) RETURNS boolean
+LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
+BEGIN
+  INSERT INTO public.execution_lease VALUES (1,p_token,now()+interval '5 minutes')
+  ON CONFLICT (id) DO UPDATE SET token=EXCLUDED.token, expires_at=EXCLUDED.expires_at
+    WHERE public.execution_lease.expires_at < now();
+  RETURN FOUND;
+END $$;
+CREATE FUNCTION public.release_execution_lease(p_token uuid) RETURNS void
+LANGUAGE sql SECURITY DEFINER SET search_path = '' AS $$
+  DELETE FROM public.execution_lease WHERE id=1 AND token=p_token;
+$$;
+REVOKE ALL ON FUNCTION public.acquire_execution_lease(uuid), public.release_execution_lease(uuid) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.acquire_execution_lease(uuid), public.release_execution_lease(uuid) TO service_role;
+
+-- Submitted/unknown/filled-but-unapplied orders block another order on the same trade.
+CREATE TABLE public.execution_orders (
+  client_order_id text PRIMARY KEY,
+  trade_id uuid NOT NULL REFERENCES public.paper_trades(id),
+  symbol text NOT NULL, side text NOT NULL CHECK(side IN ('BUY','SELL')),
+  requested_quantity numeric NOT NULL CHECK(requested_quantity>0),
+  state text NOT NULL DEFAULT 'pending' CHECK(state IN ('pending','rejected','filled','applied','unknown')),
+  response jsonb, error text, created_at timestamptz NOT NULL DEFAULT now()
+);
+CREATE UNIQUE INDEX execution_orders_unresolved ON public.execution_orders(trade_id)
+  WHERE state IN ('pending','filled','unknown');
+ALTER TABLE public.execution_orders ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON public.execution_orders FROM PUBLIC, anon, authenticated;
+GRANT SELECT ON public.execution_orders TO authenticated;
+GRANT ALL ON public.execution_orders TO service_role;
+CREATE POLICY owner_read ON public.execution_orders FOR SELECT TO authenticated USING(public.is_app_operator());
+-- Old records have no trustworthy fill-based cost basis. Do not manufacture one.
+ALTER TABLE public.paper_trades ADD COLUMN accounting_verified boolean NOT NULL DEFAULT false;
+ALTER TABLE public.paper_trades ADD COLUMN inventory_verified boolean NOT NULL DEFAULT false;
+ALTER TABLE public.paper_trades ADD COLUMN execution_error text;
+ALTER TABLE public.paper_trades ADD COLUMN exit_proceeds numeric NOT NULL DEFAULT 0;
+
+-- Persist each confirmed exit and its journal transition in one DB transaction.
+CREATE FUNCTION public.apply_confirmed_exit(p_client_id text, p_quantity numeric, p_price numeric, p_quote numeric)
+RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
+DECLARE o public.execution_orders; t public.paper_trades; remaining numeric; pnl_delta numeric; total_pnl numeric;
+BEGIN
+  SELECT * INTO o FROM public.execution_orders WHERE client_order_id=p_client_id FOR UPDATE;
+  IF NOT FOUND THEN RAISE EXCEPTION 'Order journal missing'; END IF;
+  IF o.state='applied' THEN RETURN; END IF;
+  IF o.state<>'filled' THEN RAISE EXCEPTION 'Order not confirmed'; END IF;
+  SELECT * INTO t FROM public.paper_trades WHERE id=o.trade_id FOR UPDATE;
+  remaining := COALESCE(t.remaining_quantity,t.quantity);
+  IF t.status<>'open' OR p_quantity<=0 OR p_quantity>remaining+0.00000001 OR p_quote<0 OR p_price<=0 THEN
+    RAISE EXCEPTION 'Invalid exit state; manual reconciliation required';
+  END IF;
+  remaining := greatest(0,remaining-p_quantity);
+  pnl_delta := p_quote-(t.position_value*p_quantity/t.quantity);
+  total_pnl := COALESCE(t.partial_exit_pnl,0)+pnl_delta;
+  UPDATE public.paper_trades SET remaining_quantity=remaining,
+    exit_proceeds=exit_proceeds+p_quote, execution_error=NULL,
+    status=CASE WHEN remaining<0.00000001 THEN 'closed' ELSE 'open' END,
+    exit_price=CASE WHEN remaining<0.00000001 THEN p_price ELSE exit_price END,
+    closed_at=CASE WHEN remaining<0.00000001 THEN now() ELSE NULL END,
+    partial_exit_price=CASE WHEN remaining>=0.00000001 THEN p_price ELSE partial_exit_price END,
+    partial_exit_at=CASE WHEN remaining>=0.00000001 THEN now() ELSE partial_exit_at END,
+    partial_exit_pnl=CASE WHEN t.accounting_verified THEN total_pnl ELSE partial_exit_pnl END,
+    pnl=CASE WHEN t.accounting_verified THEN total_pnl ELSE pnl END,
+    binance_close_order_id=o.response->>'orderId'
+  WHERE id=t.id;
+  UPDATE public.execution_orders SET state='applied' WHERE client_order_id=p_client_id;
+END $$;
+REVOKE ALL ON FUNCTION public.apply_confirmed_exit(text,numeric,numeric,numeric) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.apply_confirmed_exit(text,numeric,numeric,numeric) TO service_role;
+
+-- Remove BOTH legacy scans by name, never by an assumed numeric job ID.
+DO $$ DECLARE j record; BEGIN
+  FOR j IN SELECT jobid FROM cron.job WHERE jobname IN ('autonomous-strategy-scan','autonomous-position-check','safe-strategy-scan') LOOP
+    PERFORM cron.unschedule(j.jobid);
+  END LOOP;
+END $$;
+-- No replacement schedule until an operator provisions the Vault secrets and explicitly installs it.
+
+CREATE FUNCTION public.check_execution_lease(p_token uuid) RETURNS boolean
+LANGUAGE sql SECURITY DEFINER SET search_path = '' AS $$
+ SELECT EXISTS(SELECT 1 FROM public.execution_lease WHERE id=1 AND token=p_token AND expires_at>now()+interval '30 seconds');
+$$;
+REVOKE ALL ON FUNCTION public.check_execution_lease(uuid) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.check_execution_lease(uuid) TO service_role;
diff --git a/supabase/migrations/20261006053000_defi_control_plane.sql b/supabase/migrations/20261006053000_defi_control_plane.sql
new file mode 100644
index 0000000..ccca796
--- /dev/null
+++ b/supabase/migrations/20261006053000_defi_control_plane.sql
@@ -0,0 +1,92 @@
+-- No schedule or financial policy is enabled by this migration.
+CREATE TABLE public.defi_positions (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(), protocol text NOT NULL CHECK(protocol IN ('curve','uniswap','aave','balancer','compound')),
+  wallet text NOT NULL CHECK(wallet ~ '^0x[0-9a-fA-F]{40}$'), pool_ids jsonb NOT NULL DEFAULT '[]', enabled boolean NOT NULL DEFAULT false,
+  UNIQUE(protocol,wallet)
+);
+CREATE TABLE public.defi_snapshots (
+  position_id uuid REFERENCES public.defi_positions(id) NOT NULL,
+  block_number bigint NOT NULL, block_hash text NOT NULL, snapshot jsonb NOT NULL,
+  observed_at timestamptz NOT NULL DEFAULT now(), PRIMARY KEY(position_id,block_number)
+);
+CREATE TABLE public.defi_jobs (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(), protocol text NOT NULL CHECK(protocol IN ('curve','uniswap','aave','balancer','compound')),
+  chain integer NOT NULL CHECK(chain IN (1,10,137,8453,42161)), wallet text NOT NULL CHECK(wallet ~ '^0x[0-9a-f]{40}$'),
+  policy jsonb NOT NULL, state text NOT NULL DEFAULT 'draft' CHECK(state IN ('draft','approved','signing','signed','broadcast','confirmed','reverted','orphaned','blocked')),
+  nonce bigint, signed_raw text, tx_hash text UNIQUE, receipt jsonb, error text,
+  created_at timestamptz NOT NULL DEFAULT now(), updated_at timestamptz NOT NULL DEFAULT now()
+);
+CREATE UNIQUE INDEX defi_one_unsettled_nonce ON public.defi_jobs(chain,wallet) WHERE state IN ('signing','signed','broadcast','orphaned');
+CREATE TABLE public.defi_cashflows (
+  job_id uuid NOT NULL REFERENCES public.defi_jobs(id), chain integer NOT NULL, tx_hash text NOT NULL,
+  log_index integer NOT NULL, asset text NOT NULL, raw_delta numeric(78,0) NOT NULL,
+  block_hash text NOT NULL, PRIMARY KEY(chain,tx_hash,log_index)
+);
+CREATE TABLE public.defi_worker_status (
+  id integer PRIMARY KEY CHECK(id=1), paused boolean NOT NULL DEFAULT true, last_started_at timestamptz,
+  last_completed_at timestamptz, last_error text, release text NOT NULL DEFAULT 'defi-2026-10-06'
+);
+INSERT INTO public.defi_worker_status(id) VALUES(1);
+CREATE TABLE public.defi_yield_intervals (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(), position_id uuid NOT NULL REFERENCES public.defi_positions(id),
+  asset text NOT NULL, from_block bigint NOT NULL, to_block bigint NOT NULL CHECK(to_block>from_block),
+  from_hash text NOT NULL, to_hash text NOT NULL, raw_yield numeric(78,0) NOT NULL, decimals integer NOT NULL CHECK(decimals BETWEEN 0 AND 36),
+  method text NOT NULL, evidence jsonb NOT NULL, created_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE(position_id,asset,from_block,to_block)
+);
+DO $$ DECLARE t text; BEGIN
+  FOREACH t IN ARRAY ARRAY['defi_positions','defi_snapshots','defi_jobs','defi_cashflows','defi_worker_status','defi_yield_intervals'] LOOP
+    EXECUTE format('ALTER TABLE public.%I ENABLE ROW LEVEL SECURITY',t);
+    EXECUTE format('REVOKE ALL ON public.%I FROM PUBLIC,anon,authenticated',t);
+    EXECUTE format('GRANT ALL ON public.%I TO service_role',t);
+    -- Signed bytes are spend authorizations; never expose them to browser SELECT.
+    IF t <> 'defi_jobs' THEN
+      EXECUTE format('GRANT SELECT ON public.%I TO authenticated',t);
+      EXECUTE format('CREATE POLICY owner_read ON public.%I FOR SELECT TO authenticated USING(public.is_app_operator())',t);
+    END IF;
+  END LOOP;
+END $$;
+GRANT SELECT(id,protocol,chain,wallet,state,tx_hash,error,created_at,updated_at) ON public.defi_jobs TO authenticated;
+CREATE POLICY owner_read ON public.defi_jobs FOR SELECT TO authenticated USING(public.is_app_operator());
+
+CREATE FUNCTION public.settle_defi_job(p_id uuid,p_receipt jsonb,p_flows jsonb) RETURNS void
+LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
+DECLARE j public.defi_jobs; f jsonb;
+BEGIN
+ SELECT * INTO j FROM public.defi_jobs WHERE id=p_id FOR UPDATE;
+ IF NOT FOUND THEN RAISE EXCEPTION 'Missing job'; END IF;
+ IF j.state IN ('confirmed','reverted') THEN RETURN; END IF;
+ IF j.state NOT IN ('signed','broadcast') OR lower(j.tx_hash)<>lower(p_receipt->>'transactionHash') THEN RAISE EXCEPTION 'Receipt does not match journal'; END IF;
+ IF p_receipt->>'status' NOT IN ('0x0','0x1') THEN RAISE EXCEPTION 'Invalid receipt status'; END IF;
+ IF p_receipt->>'status'='0x1' THEN
+  FOR f IN SELECT * FROM jsonb_array_elements(p_flows) LOOP
+   INSERT INTO public.defi_cashflows(job_id,chain,tx_hash,log_index,asset,raw_delta,block_hash)
+   VALUES(j.id,j.chain,j.tx_hash,(f->>'logIndex')::integer,f->>'asset',(f->>'rawDelta')::numeric,p_receipt->>'blockHash');
+  END LOOP;
+ END IF;
+ UPDATE public.defi_jobs SET state=CASE WHEN p_receipt->>'status'='0x1' THEN 'confirmed' ELSE 'reverted' END,
+ receipt=p_receipt,updated_at=now(),error=NULL WHERE id=j.id;
+END $$;
+REVOKE ALL ON FUNCTION public.settle_defi_job(uuid,jsonb,jsonb) FROM PUBLIC,anon,authenticated;
+GRANT EXECUTE ON FUNCTION public.settle_defi_job(uuid,jsonb,jsonb) TO service_role;
+
+-- Verified exchange reporting: legacy table names are retained for migration compatibility.
+CREATE VIEW public.verified_live_factions WITH (security_invoker=true) AS
+SELECT f.id,f.name,f.member_name,f.persona,f.status,f.updated_at,
+  count(t.id) FILTER(WHERE t.status='open' AND t.inventory_verified) AS open_positions,
+  count(t.id) FILTER(WHERE t.closed_at>=date_trunc('day',now())) AS trades_today,
+  coalesce(sum(greatest(t.pnl,0)) FILTER(WHERE t.closed_at>=date_trunc('day',now())),0) AS profit_today,
+  coalesce(sum(greatest(-t.pnl,0)) FILTER(WHERE t.closed_at>=date_trunc('day',now())),0) AS loss_today,
+  coalesce(sum(t.pnl) FILTER(WHERE t.status='closed'),0) AS profit_total,
+  coalesce(100.0*count(t.id) FILTER(WHERE t.status='closed' AND t.pnl>0)/nullif(count(t.id) FILTER(WHERE t.status='closed'),0),0) AS win_rate,
+  count(t.id) FILTER(WHERE t.status='closed') AS verified_trade_count
+FROM public.factions f LEFT JOIN public.paper_trades t ON t.faction_id=f.id AND t.is_live AND t.accounting_verified
+GROUP BY f.id;
+REVOKE ALL ON public.verified_live_factions FROM PUBLIC,anon;
+GRANT SELECT ON public.verified_live_factions TO authenticated,service_role;
+-- Disable simulation at the deployed boundary. Old history is kept for audit only.
+UPDATE public.strategy_config SET paper_mode=false,kill_switch=true WHERE id=1;
+
+-- Historical withdrawal and routing claims require independent settlement verification.
+ALTER TABLE public.withdrawals ADD COLUMN settlement_verified boolean NOT NULL DEFAULT false;
+ALTER TABLE public.withdrawal_routes ADD COLUMN settlement_verified boolean NOT NULL DEFAULT false;
diff --git a/supabase/setup/defi-scheduler.sql b/supabase/setup/defi-scheduler.sql
new file mode 100644
index 0000000..826ac73
--- /dev/null
+++ b/supabase/setup/defi-scheduler.sql
@@ -0,0 +1,17 @@
+-- Install only after migrations, owner membership and defi-monitor deployment.
+-- Keeps running when the browser is closed. Does NOT enable signing or spending.
+DO $$ DECLARE target text; token text; j record; BEGIN
+ SELECT decrypted_secret INTO target FROM vault.decrypted_secrets WHERE name='app_supabase_url';
+ SELECT decrypted_secret INTO token FROM vault.decrypted_secrets WHERE name='app_scheduler_token';
+ IF target IS NULL OR target !~ '^https://[a-z0-9-]+\.supabase\.co$' OR token IS NULL OR length(token)<32 THEN
+  RAISE EXCEPTION 'Provision project URL and scheduler token in Vault first';
+ END IF;
+ FOR j IN SELECT jobid FROM cron.job WHERE jobname='defi-worker' LOOP PERFORM cron.unschedule(j.jobid); END LOOP;
+ PERFORM cron.schedule('defi-worker','* * * * *',$job$
+  SELECT net.http_post(
+   url := (SELECT decrypted_secret FROM vault.decrypted_secrets WHERE name='app_supabase_url') || '/functions/v1/defi-monitor/tick',
+   headers := jsonb_build_object('Content-Type','application/json','X-Scheduler-Token',(SELECT decrypted_secret FROM vault.decrypted_secrets WHERE name='app_scheduler_token')),
+   body := '{}'::jsonb,timeout_milliseconds := 120000
+  );
+ $job$);
+END $$;
diff --git a/supabase/setup/scheduler.sql b/supabase/setup/scheduler.sql
new file mode 100644
index 0000000..64b91a8
--- /dev/null
+++ b/supabase/setup/scheduler.sql
@@ -0,0 +1,24 @@
+-- OPTIONAL: run only AFTER the migration, owner setup and Edge Function deployment.
+-- Provision Vault secrets named app_supabase_url and app_scheduler_token first.
+-- The latter must equal SCHEDULER_TOKEN in Edge Function secrets (32+ random chars).
+-- This does not enable new live entries. The browser never runs automatic scans.
+DO $$
+DECLARE target text; token text; j record;
+BEGIN
+  SELECT decrypted_secret INTO target FROM vault.decrypted_secrets WHERE name='app_supabase_url';
+  SELECT decrypted_secret INTO token FROM vault.decrypted_secrets WHERE name='app_scheduler_token';
+  IF target IS NULL OR target !~ '^https://[a-z0-9-]+\.supabase\.co$' OR length(token)<32 OR token IS NULL THEN
+    RAISE EXCEPTION 'Valid project URL and 32+ character scheduler token required in Vault';
+  END IF;
+  FOR j IN SELECT jobid FROM cron.job WHERE jobname IN ('autonomous-strategy-scan','autonomous-position-check','safe-strategy-scan') LOOP
+    PERFORM cron.unschedule(j.jobid);
+  END LOOP;
+  PERFORM cron.schedule('safe-strategy-scan','* * * * *', $job$
+    SELECT net.http_post(
+      url := (SELECT decrypted_secret FROM vault.decrypted_secrets WHERE name='app_supabase_url') || '/functions/v1/binance-feed/scan',
+      headers := jsonb_build_object('Content-Type','application/json',
+        'X-Scheduler-Token',(SELECT decrypted_secret FROM vault.decrypted_secrets WHERE name='app_scheduler_token')),
+      body := '{}'::jsonb, timeout_milliseconds := 60000
+    );
+  $job$);
+END $$;
diff --git a/tests/backend.test.mjs b/tests/backend.test.mjs
new file mode 100644
index 0000000..19fe907
--- /dev/null
+++ b/tests/backend.test.mjs
@@ -0,0 +1,135 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+import ts from 'typescript';
+
+function load(db, options = {}) {
+  let handler;
+  const environment = { SCHEDULER_TOKEN: 's'.repeat(32), BINANCE_API_KEY: 'test-only', BINANCE_SECRET_KEY: 'test-only', ...options.env };
+  const context = vm.createContext({ console, Date, Map, URL, URLSearchParams, TextEncoder, Response, Request, Headers, AbortSignal,
+    crypto: globalThis.crypto,
+    createClient: () => db, Deno: { env: { get: key => environment[key] ?? '' }, serve: fn => { handler = fn; } },
+    fetch: options.fetch ?? (() => { throw new Error('Unexpected network call'); }), db,
+  });
+  for (const path of ['supabase/functions/_shared/trading-safety.ts', 'supabase/functions/_shared/auth.ts', 'supabase/functions/binance-feed/index.ts']) {
+    const source = fs.readFileSync(path, 'utf8').replace(/^import .*;\n/gm, '').replace(/^export /gm, '');
+    vm.runInContext(ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.None } }).outputText, context);
+  }
+  return { context, handler, run: code => vm.runInContext(code, context) };
+}
+function database(trade = null, options = {}) {
+  const writes = [], rpcCalls = [];
+  const state = { trade, writes, rpcCalls };
+  return Object.assign(state, {
+    auth: { getUser: async () => ({ data: { user: options.user ? { id: 'owner' } : null }, error: options.user ? null : 'invalid' }) },
+    from(table) {
+      let op = 'read', value, single = false;
+      const q = { select() { return q; }, eq() { return q; }, neq() { return q; }, in() { return q; }, limit() { return q; },
+        single() { single = true; return q; }, maybeSingle() { single = true; return q; },
+        update(v) { op = 'update'; value = v; return q; }, insert(v) { op = 'insert'; value = v; return q; },
+        then(resolve, reject) {
+          if (op !== 'read') { writes.push({ table, op, value }); if (table === 'paper_trades' && trade) Object.assign(trade, value); }
+          let data = null;
+          if (op === 'read') {
+            if (table === 'paper_trades') data = single ? trade : trade ? [trade] : [];
+            if (table === 'execution_orders') data = options.unresolved ? [{ client_order_id: 'prior' }] : [];
+            if (table === 'app_operators') data = options.operator ? { user_id: 'owner' } : null;
+            if (table === 'factions') data = { paper_balance: 10, open_positions: 1, profit_today: 0, loss_today: 0, trades_today: 0 };
+          }
+          return Promise.resolve({ data, error: null }).then(resolve, reject);
+        } };
+      return q;
+    },
+    async rpc(name, args) {
+      rpcCalls.push({ name, args });
+      return { data: name === 'acquire_execution_lease' ? options.lock !== false : true, error: null };
+    },
+  });
+}
+const config = { paperMode: true, dailyLossAccumulator: 0, dailyLossResetAt: '2026-10-04T00:00:00Z' };
+function position(live = true) { return { id: 'trade', symbol: 'TESTUSDT', side: 'long', entry_price: 100, stop_loss: 95, take_profit: 110,
+  peak_price: 100, opened_at: new Date(Date.now() - 60000).toISOString(), quantity: 1, remaining_quantity: 1,
+  inventory_verified: true, position_value: 100, partial_exit_pnl: 0, is_live: live, status: 'open', faction_id: 'test' }; }
+
+test('anonymous caller cannot read account or trigger a scan', async () => {
+  const db = database(); const app = load(db);
+  for (const path of ['account', 'scan', 'close-all', 'kill-switch']) {
+    const response = await app.handler(new Request(`https://example.test/binance-feed/${path}`, { method: 'POST' }));
+    assert.equal(response.status, 401);
+  }
+  assert.equal(db.writes.length, 0); assert.equal(db.rpcCalls.length, 0);
+});
+test('valid user without owner membership cannot execute', async () => {
+  const app = load(database(null, { user: true }));
+  const response = await app.handler(new Request('https://example.test/binance-feed/scan', { method: 'POST', headers: { Authorization: 'Bearer test' } }));
+  assert.equal(response.status, 403);
+});
+test('scheduler credential is accepted only on POST scan; duplicate worker fails closed', async () => {
+  const db = database(null, { lock: false }); const app = load(db);
+  const headers = { 'X-Scheduler-Token': 's'.repeat(32) };
+  assert.equal((await app.handler(new Request('https://example.test/binance-feed/scan', { method: 'POST', headers }))).status, 409);
+  assert.equal((await app.handler(new Request('https://example.test/binance-feed/close-all', { method: 'POST', headers }))).status, 401);
+  assert.equal(db.writes.length, 0);
+});
+test('GET is never permitted to execute a scan', async () => {
+  const db = database(null, { user: true, operator: true }); const app = load(db);
+  assert.equal((await app.handler(new Request('https://example.test/binance-feed/scan', { headers: { Authorization: 'Bearer test' } }))).status, 405);
+  assert.equal(db.rpcCalls.length, 0);
+});
+test('rejected exchange exit remains open and has an unresolved journal; first-minute stop is attempted', async () => {
+  const trade = position(); const db = database(trade); let submissions = 0;
+  const app = load(db, { fetch: async (url) => {
+    if (url.includes('exchangeInfo')) return Response.json({ symbols: [{ symbol: 'TESTUSDT', status: 'TRADING', filters: [
+      { filterType: 'LOT_SIZE', minQty: '0.01', maxQty: '100', stepSize: '0.01' }, { filterType: 'MIN_NOTIONAL', minNotional: '1' },
+    ] }] });
+    submissions++; return Response.json({ code: -2010, msg: 'Rejected' }, { status: 400 });
+  } });
+  app.context.config = config;
+  const result = await app.run('checkOpenPositions(new Map([["TESTUSDT",80]]),config,false,"lease-token")');
+  assert.equal(submissions, 1); assert.equal(result.failed, 1); assert.equal(trade.status, 'open');
+  assert.equal(trade.remaining_quantity, 1); assert.ok(trade.execution_error);
+  assert.ok(db.writes.some(w => w.table === 'execution_orders' && w.value.state === 'unknown'));
+  assert.ok(!db.rpcCalls.some(c => c.name === 'apply_confirmed_exit'));
+});
+test('an unresolved order cannot be sent twice', async () => {
+  const db = database(position(), { unresolved: true }); const app = load(db); app.context.config = config;
+  const result = await app.run('checkOpenPositions(new Map([["TESTUSDT",80]]),config,true,"lease-token")');
+  assert.equal(result.failed, 1);
+  assert.ok(!db.writes.some(w => w.table === 'execution_orders'));
+});
