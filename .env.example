VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the project's public anon/publishable key. Never use a service-role key here.
VITE_SUPABASE_ANON_KEY=
# For a GitHub Pages project site, set /Bolt.new/ when building.
BASE_PATH=/
# Public sales (collection + Signals Pro) stay paused unless set to true. Server also needs SALES_ENABLED=true.
VITE_SALES_ENABLED=false
